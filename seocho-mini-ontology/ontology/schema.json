{
  "version": "0.1.0",
  "description": "서초 AI 페스타 미니 온톨로지 스키마(틀) — 학습용. onto-osint의 ontology/schema.json을 단순화한 버전. 여기에는 '종류(클래스)'와 '관계'만 적는다. 실제 데이터는 instances.json에.",
  "last_updated": "2026-06-15",

  "classes": [
    {
      "id": "Entity",
      "label": "엔티티",
      "description": "최상위 클래스 (모든 것의 부모)",
      "subclasses": [
        {
          "id": "Event",
          "label": "행사",
          "description": "페스타에서 열리는 강연·체험부스·공모전 등",
          "properties": ["name", "event_type", "date", "time", "topic", "target_age", "source_url"]
        },
        {
          "id": "Venue",
          "label": "공간",
          "description": "행사가 열리는 장소·존",
          "properties": ["name", "zone_type", "indoor_outdoor", "accessible"]
        },
        {
          "id": "Organization",
          "label": "주체",
          "description": "행사를 운영·주최·자문하는 곳",
          "properties": ["name", "org_type", "role"]
        },
        {
          "id": "AITopic",
          "label": "기술분야",
          "description": "행사가 다루는 AI 주제 (생성형AI·로봇·음성·비전 등)",
          "properties": ["name"]
        },
        {
          "id": "TargetGroup",
          "label": "대상",
          "description": "행사가 겨냥하는 대상. 아래로 세대(AgeGroup)와 계층(Audience)으로 나뉜다.",
          "subclasses": [
            {
              "id": "AgeGroup",
              "label": "대상세대",
              "description": "나이 기준 대상 (아동·어르신·가족 등)",
              "properties": ["name"]
            },
            {
              "id": "Audience",
              "label": "대상계층",
              "description": "직업·라이프스타일 기준 대상 (솔로프리너·학생·직장인 등)",
              "properties": ["name"]
            }
          ]
        }
      ]
    }
  ],

  "relations": [
    { "id": "operates",  "label": "운영한다",        "domain": "Organization", "range": "Event" },
    { "id": "hostsAt",   "label": "~에서 열린다",     "domain": "Event",        "range": "Venue" },
    { "id": "locatedIn", "label": "~안에 위치한다",   "domain": "Venue",        "range": "Venue" },
    { "id": "demos",     "label": "~을 다룬다",       "domain": "Event",        "range": "AITopic" },
    { "id": "targets",   "label": "~을 대상으로한다", "domain": "Event",        "range": "TargetGroup" },
    { "id": "advises",   "label": "~을 자문한다",     "domain": "Organization", "range": "Event" },
    { "id": "visitCombo", "label": "함께 둘러보기",   "domain": "Event",        "range": "Event", "inferred": true, "note": "사람이 직접 안 적고 '추론'으로 생기는 관계. 그래프에선 점선으로 표시." }
  ],

  "rules": [
    {
      "id": "same_venue_combo",
      "label": "같은 장소 함께보기",
      "if": "두 행사(Event, 부스/프로그램)가 같은 Venue에서 열린다(hostsAt) — 단, 페스타 자체는 제외",
      "then": "그 둘을 visitCombo 로 잇는다",
      "confidence": 0.9
    }
  ],

  "_수연님_TODO": "필요한 클래스나 관계가 떠오르면 여기 추가해보세요. (예: 클래스 Award(수상작), Sponsor(후원사) / 관계 sponsors(후원한다), partOfSeries(시리즈의 일부다))"
}
